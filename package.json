{
  "name": "termui",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f",
  "type": "module",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=12.5.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm demos:build && next build --webpack",
    "predev": "pnpm demos:build",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write .",
    "knip": "knip --include files,dependencies,binaries",
    "shadcn": "shadcn",
    "test": "node --test tests/*.test.mts",
    "check:quality:precommit": "pnpm lint",
    "check:quality:fast": "pnpm lint && pnpm typecheck",
    "check:quality:rust": "cargo fmt --all -- --check && cargo clippy --locked --workspace --all-targets -- -D warnings && cargo test --locked --workspace",
    "check:quality": "pnpm check:quality:fast && pnpm knip && pnpm test && pnpm check:quality:rust",
    "setup:hooks": "git config core.hooksPath .githooks",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "demos:build": "node ./scripts/build-rust-demos.mts",
    "demos:pipeline:test": "node --test tests/build-ratzilla-demos.test.mts",
    "demos:ratzilla:build": "node ./scripts/build-ratzilla-demos.mts build",
    "demos:ratzilla:serve": "node ./scripts/build-ratzilla-demos.mts serve",
    "test:button": "node --test tests/button.test.mts",
    "test:card": "node --test tests/card.test.mts",
    "test:toast": "node --test tests/toast.test.mts",
    "test:drawer": "node --test tests/drawer.test.mts",
    "test:text-input": "node --test tests/text-input.test.mts",
    "postinstall": "fumadocs-mdx",
    "build:production": "next build --webpack"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "0.2.6",
    "front-matter": "^4.0.2",
    "fumadocs-core": "^16.7.10",
    "fumadocs-mdx": "^14.2.11",
    "jiti": "^2.6.1",
    "jotai": "^2.19.0",
    "lru-cache": "^11.2.7",
    "lucide-react": "1.7.0",
    "motion": "^12.38.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.8",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hotkeys-hook": "^5.2.4",
    "rehype-pretty-code": "^0.14.3",
    "shiki": "^4.0.2",
    "sonner": "^2.0.7",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.4",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "knip": "6.34.0",
    "playwright": "^1.63.0",
    "shadcn": "4.3.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^6"
  }
}
