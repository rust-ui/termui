{
  "name": "termui",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f",
  "type": "module",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=12.5.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm demos:build && pnpm registry:build && next build --webpack",
    "predev": "pnpm demos:build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "demos:build": "node ./scripts/build-rust-demos.mts",
    "demos:ratzilla:build": "cd crates/termui-registry && env -u NO_COLOR trunk build --release --dist ../../public/demos/button-interactive index.html && env -u NO_COLOR trunk build --release --config Trunk.toml --dist ../../public/demos/dialog-interactive --public-url /demos/dialog-interactive/ dialog-interactive.html && env -u NO_COLOR trunk build --release --config Trunk.toml --dist ../../public/demos/text-input-interactive --public-url /demos/text-input-interactive/ text-input-interactive.html",
    "demos:ratzilla:serve": "cd crates/termui-registry && env -u NO_COLOR trunk serve --public-url / --serve-base / --address 127.0.0.1 --port 8081",
    "examples:build": "node ./scripts/build-examples.mts",
    "registry:build": "pnpm examples:build && node ./scripts/build-registry.mts",
    "postinstall": "fumadocs-mdx",
    "build:production": "pnpm registry:build && next build --webpack"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "0.2.6",
    "front-matter": "^4.0.2",
    "fumadocs-core": "^16.7.10",
    "fumadocs-mdx": "^14.2.11",
    "glob": "13.0.6",
    "jiti": "^2.6.1",
    "jotai": "^2.19.0",
    "lru-cache": "^11.2.7",
    "lucide-react": "1.7.0",
    "marked": "17.0.5",
    "motion": "^12.38.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.8",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hotkeys-hook": "^5.2.4",
    "rehype-pretty-code": "^0.14.3",
    "shiki": "^4.0.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "ts-morph": "^26.0.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "shadcn": "4.3.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^6"
  }
}
